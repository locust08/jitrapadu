{
  "name": "ai-website-clone-template",
  "version": "0.6.1",
  "private": true,
  "description": "Clone any website into a clean, modern Next.js codebase using AI coding agents",
  "author": "JCodesMore",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/JCodesMore/ai-website-cloner-template.git"
  },
  "homepage": "https://github.com/JCodesMore/ai-website-cloner-template",
  "bugs": {
    "url": "https://github.com/JCodesMore/ai-website-cloner-template/issues"
  },
  "keywords": [
    "claude-code",
    "website-clone",
    "reverse-engineering",
    "nextjs",
    "ai",
    "template",
    "tailwindcss",
    "shadcn-ui"
  ],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "next dev --port 3001 --hostname localhost",
    "build": "next build",
    "start": "next start --port 3001 --hostname localhost",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "check": "npm run lint && npm run typecheck && npm run build",
    "preview": "node scripts/preview.mjs",
    "test": "node --import tsx --test --test-force-exit tests/cms/*.test.ts",
    "cms:types": "payload generate:types",
    "cms:import-map": "payload generate:importmap",
    "cms:import": "tsx --env-file=.env scripts/cms/import-original.ts",
    "cms:verify": "tsx --env-file=.env scripts/cms/verify-import.ts",
    "cms:seed-products": "tsx --env-file=.env scripts/cms/seed-products.ts",
    "cms:verify-frontend": "node --import tsx scripts/cms/verify-frontend.ts",
    "cms:verify-termination": "node --import tsx scripts/cms/verify-termination.ts",
    "cms:seed-posts": "tsx --env-file=.env scripts/cms/seed-posts.ts",
    "cms:retry-notifications": "tsx --env-file=.env scripts/cms/retry-notifications.ts",
    "cms:verify-backend": "node --import tsx scripts/cms/verify-backend.ts",
    "cms:verify-backend-termination": "node --import tsx scripts/cms/verify-termination.ts --backend"
  },
  "dependencies": {
    "@base-ui/react": "^1.3.0",
    "@payloadcms/db-sqlite": "3.91.0",
    "@payloadcms/email-nodemailer": "3.91.0",
    "@payloadcms/next": "3.91.0",
    "@payloadcms/richtext-lexical": "3.91.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "graphql": "16.11.0",
    "lucide-react": "^1.6.0",
    "next": "^16.4.2",
    "payload": "3.91.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "sharp": "0.35.5",
    "tailwind-merge": "^3.5.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^24",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@webgpu/types": "^0.1.74",
    "eslint": "^9",
    "eslint-config-next": "^16.4.2",
    "shadcn": "^4.1.0",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5"
  },
  "type": "module"
}
