# Generate a random secret locally; do not use this comment as a secret.
PAYLOAD_SECRET=
# Optional; defaults to temp/cms/payload.db in this checkout.
# DATABASE_URI=file:/absolute/path/to/payload.db
NEXT_PUBLIC_SERVER_URL=http://localhost:3001

# Optional server-only absolute upload directory (also used by isolated tests).
# PAYLOAD_UPLOAD_DIR=/absolute/path/to/uploads

# Contact endpoint: comma-separated exact origins (no paths/trailing slash).
CONTACT_ALLOWED_ORIGINS=http://localhost:3001
# Leave SMTP unset until a verified sender is provided. Notifications remain private.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM_ADDRESS=
SMTP_FROM_NAME=Jitrapadu Engineering
